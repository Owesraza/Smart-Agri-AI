# ============================================================
# SmartAgri AI – Backend Environment Variables (Example Template)
# ============================================================

# Application
APP_NAME=SmartAgri AI
APP_VERSION=1.0.0
DEBUG=False
API_BASE_URL=http://localhost:8000

# Database (SQLite default — override for PostgreSQL/MySQL)
DATABASE_URL=sqlite+aiosqlite:///./smartagri.db

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=365

# Password Reset
RESET_TOKEN_EXPIRE_MINUTES=15

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Engine
GEMINI_API_KEY=

# Live Telemetry APIs
OPENWEATHER_API_KEY=

# Official AGMARKNET Government Mandi Price API
# Source: Directorate of Marketing & Inspection (DMI), Ministry of Agriculture
AGMARKNET_API_KEY=
